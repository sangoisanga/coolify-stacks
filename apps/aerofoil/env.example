# AeroFoil env for Coolify.
# In Coolify UI:
#   - Set SERVICE_FQDN_AEROFOIL_8465 = https://o.delulo.uk (Coolify auto-creates).
# Do NOT commit real values. Copy this file to env.local for the generated instance.

# Match the VPS user that owns /data/aerofoil/library.
PUID=1000
PGID=1000

# Admin login for the AeroFoil web UI and shop API.
AEROFOIL_ADMIN_NAME=admin
AEROFOIL_ADMIN_PASSWORD=CHANGE_ME_STRONG

# Generate with: openssl rand -hex 32
AEROFOIL_SECRET_KEY=CHANGE_ME_64_HEX_CHARS

# CIDR(s) Traefik's proxy IP falls in, so AeroFoil trusts its X-Forwarded-* headers.
AEROFOIL_TRUSTED_PROXIES=172.16.0.0/12
