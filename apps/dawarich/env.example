# Dawarich env for Coolify.
# In Coolify UI:
#   - Set SERVICE_FQDN_DAWARICH_3000 = https://<your-domain> (Coolify auto-creates).
#   - Set APPLICATION_HOSTS = <your-domain> (bare hostname, comma-separated for multiple).
# Do NOT commit real values. Copy this file to env.local for the generated instance.

POSTGRES_USER=dawarich
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=dawarich_production

APPLICATION_HOSTS=dawarich.example.com

# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=CHANGE_ME_128_HEX_CHARS

TIME_ZONE=Asia/Ho_Chi_Minh
WEB_CONCURRENCY=1
BACKGROUND_PROCESSING_CONCURRENCY=3

APP_CPU_LIMIT=0.50
APP_MEMORY_LIMIT=4G
